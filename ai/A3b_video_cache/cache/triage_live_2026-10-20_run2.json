        "trang_thai_bang_chung": "can_xac_minh"
      },
      {
        "alert_id": "zap-944ee923a3688327",
        "is_real": true,
        "priority": "P3",
        "reason": "Bằng chứng hiển thị rõ ràng header 'X-Powered-By: Express' trong phản hồi HTTP, xác nhận máy chủ đang tiết lộ công nghệ nền tảng. Đây là lỗi thông tin (Information Disclosure) thực tế, không phải giả âm. Mức độ rủi ro thấp vì chỉ tiết lộ tên framework, không trực tiếp dẫn đến khai thác lỗ hổng bảo mật nghiêm trọng, nhưng vẫn nên khắc phục để giảm bề mặt tấn công.",
        "confidence": 1.0,
        "trang_thai_bang_chung": "can_xac_minh"
      },
      {
